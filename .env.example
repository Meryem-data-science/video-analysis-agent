# Copiez ce fichier vers .env uniquement pour votre environnement local.
# Le pipeline ne charge pas automatiquement .env : exportez les variables avec
# votre shell ou un gestionnaire de secrets.

# Racine facultative contenant les vidéos utilisateur.
VIDEO_ROOT=videos

# Requis uniquement pour le mode VLM automatic avec provider=gemini.
GEMINI_API_KEY=

# Overrides facultatifs des modèles Gemini.
GEMINI_VLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

